{
  "schema_version": "cell.phh-intracellular-mobility-contract.v1",
  "contract_id": "phh_intracellular_mobility_contract_v1",
  "canonical_null_token": "null",
  "allowed_split_roles": [
    "calibration",
    "internal_validation",
    "independent_heldout"
  ],
  "target_species_ids": [
    "ADP",
    "AMP",
    "ATP",
    "CoA",
    "HMG_CoA",
    "NADH",
    "NAD_plus",
    "acetoacetate",
    "acetoacetyl_CoA",
    "acetone",
    "acetyl_CoA",
    "alanine",
    "alpha_ketoglutarate",
    "ammonia",
    "arginine",
    "argininosuccinate",
    "aspartate",
    "beta_hydroxybutyrate",
    "carbamoyl_phosphate",
    "citrulline",
    "dihydroxyacetone_phosphate",
    "fatty_acids",
    "fructose_1_6_bisphosphate",
    "fructose_6_phosphate",
    "fumarate",
    "glucose",
    "glucose_6_phosphate",
    "glucose_blood",
    "glucose_cyto",
    "glutamate",
    "glutamine",
    "glycerol",
    "glycerol_3_phosphate",
    "glycogen",
    "lactate",
    "malonyl_CoA",
    "mito_acetyl_CoA",
    "ornithine",
    "oxaloacetate",
    "palmitate",
    "phosphoenolpyruvate",
    "pyruvate",
    "urea"
  ],
  "required_stage_ids": [
    "molecular_identity_state",
    "compartment_localization",
    "probe_scale_calibration",
    "raw_mobility_trajectory",
    "apparent_diffusivity_model",
    "local_crowding_abundance_field",
    "binding_free_fraction",
    "perturbation_transport_response",
    "independent_heldout_validation"
  ],
  "required_columns": [
    {"id": "record_id", "description": "Globally unique raw observation identifier."},
    {"id": "target_species_id", "description": "Exact engine species whose physical state is being evaluated."},
    {"id": "stage_id", "description": "One required mobility/crowding evidence stage."},
    {"id": "series_id", "description": "Identifier joining raw ordered observations from one assay curve."},
    {"id": "observation_index", "description": "Non-negative integer index within the raw series."},
    {"id": "donor_id", "description": "Study-scoped PHH donor identifier."},
    {"id": "split_role", "description": "Calibration, internal validation, or independent held-out assignment."},
    {"id": "source_study_id", "description": "Stable DOI, PMID, repository accession, or primary-study identifier."},
    {"id": "source_locator", "description": "Exact figure, table, raw file, trace, cell, and row locator."},
    {"id": "species", "description": "Must be Homo sapiens."},
    {"id": "biological_system", "description": "Exact primary-human-hepatocyte preparation."},
    {"id": "culture_format", "description": "In-situ, slice, sandwich, spheroid, organoid, or exact culture context."},
    {"id": "tissue_health_state", "description": "Healthy/non-diseased status of the source cells."},
    {"id": "liver_zone", "description": "Measured zonation assignment or explicit unresolved token."},
    {"id": "biological_replicate_id", "description": "Biological replicate identifier; not a synthetic donor."},
    {"id": "compartment", "description": "Measured intracellular or extracellular compartment."},
    {"id": "subcompartment", "description": "Measured local domain or explicit unresolved token."},
    {"id": "molecular_form", "description": "Chemical, oligomeric, bound/free, carrier-associated, or polymeric state."},
    {"id": "label_or_probe_identity", "description": "Exact fluorophore, sensor, particle, construct, isotope, or label-free method."},
    {"id": "probe_hydrodynamic_radius_value", "description": "Probe/species hydrodynamic radius in the original source unit."},
    {"id": "probe_hydrodynamic_radius_unit", "description": "Original radius unit; no automatic conversion."},
    {"id": "measurement_method", "description": "FCS, FRAP, SPT, microrheology, NMR, or exact raw method."},
    {"id": "independent_axis_name", "description": "Lag time, recovery time, position, probe size, or other raw axis."},
    {"id": "independent_value", "description": "Finite raw independent-axis value."},
    {"id": "independent_unit", "description": "Original independent-axis unit."},
    {"id": "observed_quantity", "description": "Raw fluorescence, displacement, autocorrelation, diffusivity, concentration, or other quantity."},
    {"id": "observed_value", "description": "Finite raw observed value."},
    {"id": "observed_unit", "description": "Original observed unit."},
    {"id": "uncertainty_value", "description": "Finite non-negative raw uncertainty."},
    {"id": "uncertainty_type", "description": "SD, SEM, CI, localization error, fit covariance, or exact definition."},
    {"id": "assay_temperature_value", "description": "Finite assay temperature in the source unit."},
    {"id": "assay_temperature_unit", "description": "Original temperature unit."},
    {"id": "assay_ph", "description": "Finite assay pH."},
    {"id": "raw_artifact_path", "description": "Checksum-frozen raw or digitized observation artifact."},
    {"id": "raw_artifact_sha256", "description": "SHA-256 of the exact observation artifact."},
    {"id": "manual_primary_source_review_status", "description": "Must be pass before scientific promotion."}
  ],
  "conditional_columns": [
    {"id": "apparent_diffusivity_value", "description": "Source-reported or separately fitted apparent diffusivity."},
    {"id": "apparent_diffusivity_unit", "description": "Original diffusivity unit."},
    {"id": "diffusion_tensor_xx", "description": "Tensor xx component when spatial anisotropy is identified."},
    {"id": "diffusion_tensor_yy", "description": "Tensor yy component when spatial anisotropy is identified."},
    {"id": "diffusion_tensor_zz", "description": "Tensor zz component when spatial anisotropy is identified."},
    {"id": "anomalous_exponent", "description": "Source-defined anomalous diffusion exponent."},
    {"id": "free_fraction_value", "description": "Measured free/mobile fraction."},
    {"id": "free_fraction_unit", "description": "Original fraction or percentage unit."},
    {"id": "local_crowder_value", "description": "Measured local protein/biomass/obstacle abundance."},
    {"id": "local_crowder_unit", "description": "Original local abundance unit and denominator."},
    {"id": "perturbation_identity", "description": "Exact crowding, binding, cytoskeleton, osmotic, or metabolic perturbation."},
    {"id": "perturbation_value", "description": "Finite perturbation magnitude."},
    {"id": "perturbation_unit", "description": "Original perturbation unit."},
    {"id": "censoring_or_missingness", "description": "Detection limit, truncation, bleaching, lost track, or missingness."}
  ],
  "mobility_gate": {
    "version": "phh_intracellular_mobility_gate_v1",
    "minimum_ordered_points_per_dynamic_series": 3,
    "minimum_probe_sizes_for_crowding_law": 3,
    "same_donor_required_for_calibration_chain": true,
    "same_compartment_required_for_calibration_chain": true,
    "same_molecular_form_required_for_calibration_chain": true,
    "probe_size_and_label_effect_required": true,
    "raw_units_and_uncertainty_required": true,
    "healthy_human_context_required": true,
    "donor_disjoint_validation_required": true,
    "independent_heldout_study_required": true,
    "frozen_model_before_heldout_access_required": true,
    "automatic_stokes_einstein_conversion": false,
    "automatic_cell_line_transfer": false,
    "automatic_cross_species_transfer": false,
    "automatic_global_viscosity_multiplier": false,
    "automatic_diffusivity_activation": false,
    "automatic_crowding_law_activation": false,
    "automatic_reaction_coupling": false
  },
  "policy": {
    "manual_primary_source_review_required": true,
    "water_or_gfp_probe_may_stand_in_for_every_species": false,
    "one_probe_size_defines_crowding_law": false,
    "reported_mean_without_raw_curve_is_sufficient": false,
    "bulk_tissue_diffusion_equals_intracellular_phh_diffusion": false,
    "missing_mobility_means_immobile": false,
    "visual_crowder_points_are_measurements": false,
    "automatic_unit_conversion": false,
    "automatic_parameter_activation": false
  }
}
