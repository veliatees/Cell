{
  "schema_version": "cell.phh-mechanics-calibration-contract.v1",
  "contract_id": "phh_mechanics_calibration_contract_v1",
  "canonical_null_token": "null",
  "allowed_split_roles": [
    "calibration",
    "internal_validation",
    "independent_heldout"
  ],
  "allowed_record_kinds": [
    "raw_observation",
    "reported_parameter"
  ],
  "allowed_assay_types": [
    "atomic_force_microscopy",
    "micropipette_aspiration",
    "osmotic_challenge",
    "optical_tweezer",
    "microfluidic_deformation",
    "particle_tracking_microrheology",
    "pressure_relaxation",
    "other_mechanics"
  ],
  "allowed_stages": [
    "baseline",
    "loading",
    "hold",
    "relaxation",
    "washout",
    "derived_parameter"
  ],
  "measured_quantities": {
    "cell_volume": "um3",
    "surface_area": "um2",
    "normal_displacement": "um",
    "indentation_depth": "um",
    "applied_force": "N",
    "pressure_difference": "Pa",
    "aspiration_length": "um",
    "membrane_tension": "N/m",
    "bending_modulus": "J",
    "area_expansion_modulus": "N/m",
    "cortical_elastic_modulus": "Pa",
    "cortical_viscosity": "Pa*s",
    "hydraulic_permeability": "m/(Pa*s)",
    "poroelastic_diffusivity": "m2/s",
    "cytosol_apparent_viscosity": "Pa*s"
  },
  "required_columns": [
    {"id": "record_id", "description": "Globally unique mechanics row identifier."},
    {"id": "donor_id", "description": "Study-scoped human donor identifier."},
    {"id": "source_study_id", "description": "Stable DOI, PMID, repository accession, or primary-study identifier."},
    {"id": "source_locator", "description": "Exact figure, table, supplementary file, specimen, or repository locator."},
    {"id": "split_role", "description": "Calibration, internal validation, or independent held-out assignment."},
    {"id": "species", "description": "Must be Homo sapiens."},
    {"id": "biological_system", "description": "Must explicitly identify primary human hepatocytes."},
    {"id": "tissue_health_state", "description": "Healthy/non-diseased donor context."},
    {"id": "preparation_context", "description": "In-situ, slice, freshly isolated, plated, sandwich, spheroid, or exact alternative."},
    {"id": "culture_format", "description": "Exact substrate, matrix, co-culture, dimensionality, and culture duration."},
    {"id": "liver_zone", "description": "Measured zone assignment or explicit unresolved token."},
    {"id": "nutritional_state", "description": "Exact nutrient/endocrine context."},
    {"id": "temperature_c", "description": "Assay temperature in degrees Celsius."},
    {"id": "medium_composition", "description": "Exact medium and osmolarity context."},
    {"id": "biological_replicate_id", "description": "Biological replicate; not a synthetic donor."},
    {"id": "cell_id", "description": "Physical measured cell identifier."},
    {"id": "assay_id", "description": "Stable assay/run identifier."},
    {"id": "trajectory_id", "description": "Stable time-series or parameter-source trajectory identifier."},
    {"id": "record_kind", "description": "Raw observation or source-reported parameter."},
    {"id": "assay_type", "description": "One allowed assay type."},
    {"id": "stage", "description": "Baseline, loading, hold, relaxation, washout, or derived parameter."},
    {"id": "timepoint_index", "description": "Non-negative integer within one trajectory."},
    {"id": "time_from_assay_start_s", "description": "Raw elapsed time in seconds."},
    {"id": "measured_quantity_id", "description": "One exact measured_quantities key."},
    {"id": "value", "description": "One finite source-reported number."},
    {"id": "unit", "description": "Must exactly match the canonical unit for measured_quantity_id."},
    {"id": "measurement_method", "description": "Instrument, acquisition, calibration, and analysis method."},
    {"id": "coordinate_frame", "description": "Cell/specimen-fixed frame used for geometry and loading."},
    {"id": "membrane_domain", "description": "Sinusoidal, lateral, canalicular, whole-cell, unresolved, or exact source label."},
    {"id": "uncertainty_value", "description": "Finite non-negative uncertainty in the same unit as value."},
    {"id": "uncertainty_type", "description": "SD, SEM, CI, instrument error, segmentation error, or exact source term."},
    {"id": "raw_artifact_path", "description": "Frozen raw or source-extracted data artifact."},
    {"id": "raw_artifact_sha256", "description": "SHA-256 of the exact raw artifact."},
    {"id": "cell_viability_context", "description": "Viability and integrity assessment surrounding the mechanics assay."},
    {"id": "manual_primary_source_review_status", "description": "Must be pass before structural promotion."}
  ],
  "conditional_columns": [
    {"id": "stimulus_identity", "description": "Applied pressure, force, osmotic, contact, or other perturbation."},
    {"id": "stimulus_value", "description": "Finite perturbation magnitude when reported."},
    {"id": "stimulus_unit", "description": "Exact source unit paired with stimulus_value."},
    {"id": "loading_axis", "description": "Loading direction in the declared coordinate frame."},
    {"id": "boundary_condition_description", "description": "Contact, pressure, anchoring, flow, and free-surface conditions."},
    {"id": "paired_mesh_record_id", "description": "Same-cell PHH mesh-manifest record when available."},
    {"id": "derived_from_trajectory_ids", "description": "Source trajectory identifiers underlying a reported parameter."},
    {"id": "constitutive_model_equation", "description": "Exact fitted equation for a reported parameter."},
    {"id": "fitting_report_path", "description": "Frozen fitting and identifiability report."},
    {"id": "fitting_report_sha256", "description": "SHA-256 paired with fitting_report_path."},
    {"id": "protocol_report_path", "description": "Frozen protocol and boundary-condition report."},
    {"id": "protocol_report_sha256", "description": "SHA-256 paired with protocol_report_path."},
    {"id": "censoring_or_missingness", "description": "Dropout, truncation, rupture, detachment, or missing-observation status."}
  ],
  "trajectory_gate": {
    "version": "phh_mechanics_trajectory_gate_v1",
    "minimum_raw_timepoint_count": 3,
    "required_stages": [
      "baseline",
      "loading",
      "relaxation"
    ],
    "same_donor_required": true,
    "same_cell_required": true,
    "same_assay_required": true,
    "same_quantity_required": true,
    "same_coordinate_frame_required": true,
    "strictly_increasing_time_required": true,
    "raw_artifact_checksum_required": true,
    "paired_mesh_required_for_spatial_fsi": true,
    "boundary_conditions_required_for_spatial_fsi": true,
    "donor_disjoint_validation_required": true,
    "independent_heldout_study_required": true,
    "frozen_constitutive_model_before_heldout_access_required": true,
    "automatic_parameter_fitting": false,
    "automatic_unit_conversion": false,
    "automatic_proxy_substitution": false,
    "automatic_runtime_activation": false,
    "automatic_membrane_feedback": false
  },
  "policy": {
    "manual_primary_source_review_required": true,
    "aggregate_tissue_value_may_initialize_single_cell": false,
    "cell_line_mechanics_may_initialize_healthy_phh": false,
    "nonhuman_mechanics_may_initialize_healthy_phh": false,
    "renderer_deformation_is_measurement": false,
    "reported_parameter_may_replace_raw_validation_trajectory": false,
    "mesh_implies_mechanics": false,
    "one_assay_identifies_all_constitutive_parameters": false,
    "interpolation_for_heldout_validation": false,
    "automatic_parameter_activation": false,
    "automatic_runtime_coupling": false
  }
}
