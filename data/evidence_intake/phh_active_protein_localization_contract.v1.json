  "allowed_split_roles": ["calibration", "internal_validation", "independent_heldout"],
  "allowed_source_types": [
    "primary_experiment",
    "primary_data_repository_record",
    "primary_model_with_traceable_measurement"
  ],
  "allowed_context_roles": [
    "direct_healthy_phh",
    "human_liver_bridge",
    "mechanistic_human_system_candidate",
    "independent_healthy_phh_validation"
  ],
  "allowed_manual_review_statuses": ["pending", "verified"],
  "allowed_observable_kinds": [
    "copies",
    "amount",
    "density",
    "fraction",
    "concentration",
    "area",
    "volume",
    "activity",
    "functional_response",
    "validation_result"
  ],
  "localization_gate": {
    "version": "phh_active_protein_localization_gate_v1",
    "same_donor_total_localized_active_function_required": true,
    "same_assay_or_explicit_cross_assay_bridge_required": true,
    "surface_area_denominator_for_membrane_density_required": true,
    "aqueous_volume_denominator_for_cytosolic_concentration_required": true,
    "polarity_state_required_for_membrane_proteins": true,
    "operational_active_state_definition_required": true,
    "three_or_more_timepoints_for_functional_and_validation_series_required": true,
    "donor_disjoint_validation_required": true,
    "independent_heldout_study_required": true,
    "frozen_model_before_heldout_access_required": true,
    "automatic_unit_conversion": false,
    "automatic_total_to_surface_conversion": false,
    "automatic_surface_to_active_conversion": false,
    "automatic_flux_scaling": false,
    "automatic_cell_state_coupling": false
  },
  "policy": {
    "manual_primary_source_review_required": true,
    "cross_species_transfer_allowed": false,
    "cell_line_to_healthy_phh_transfer_allowed": false,
    "copies_per_nucleus_may_equal_copies_per_cell": false,
    "surface_capture_identity_may_equal_surface_abundance": false,
    "total_abundance_may_equal_active_abundance": false,
    "tissue_membrane_fraction_may_equal_canalicular_domain": false,
    "missing_slot_means_zero": false,
    "automatic_parameter_activation": false,
    "automatic_predictive_execution": false
  }
