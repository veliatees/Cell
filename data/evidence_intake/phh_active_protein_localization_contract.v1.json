    {"id": "probe_or_substrate_concentration_unit", "description": "Raw concentration unit."},
    {"id": "uncertainty_lower", "description": "Raw lower uncertainty bound."},
    {"id": "uncertainty_upper", "description": "Raw upper uncertainty bound."},
    {"id": "uncertainty_unit", "description": "Raw uncertainty unit."},
    {"id": "uncertainty_type", "description": "SD, SEM, CI, credible interval, range, or source label."},
    {"id": "validation_model_artifact_sha256", "description": "Frozen model artifact digest used for held-out evaluation."},
    {"id": "validation_prediction_id", "description": "Immutable held-out prediction identifier."},
    {"id": "validation_observation_id", "description": "Immutable held-out observation identifier."},
    {"id": "frozen_before_heldout_access", "description": "Whether model and measurement operators were frozen before access."}
