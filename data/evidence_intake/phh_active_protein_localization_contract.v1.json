    {"id": "culture_format", "description": "Culture or tissue format."},
    {"id": "health_state", "description": "Reported donor or tissue health state."},
    {"id": "polarity_state", "description": "Reported polarity and canalicular-network state."},
    {"id": "biological_replicate_id", "description": "Reported biological replicate or donor sample identifier."},
    {"id": "assay", "description": "Exact abundance, localization, activity, or functional assay."},
    {"id": "compartment", "description": "Measured compartment."},
    {"id": "membrane_domain", "description": "Measured membrane domain or null for cytosolic GCK."},
    {"id": "time_value", "description": "Raw source-reported time value."},
    {"id": "time_unit", "description": "Raw source-reported time unit."},
    {"id": "reported_value", "description": "Raw source-reported numeric value."},
    {"id": "reported_unit", "description": "Raw source-reported unit."},
    {"id": "reported_statistic", "description": "Raw, mean, median, fitted parameter, or other statistic."},
    {"id": "sample_size", "description": "Reported biological sample size."},
    {"id": "denominator_type", "description": "Per cell, nucleus, protein mass, membrane area, cytosol volume, or exact source denominator."},
    {"id": "manual_primary_source_review_status", "description": "Pending or verified manual source review."},
    {"id": "context_role", "description": "Direct PHH, human bridge, mechanistic candidate, or independent PHH validation."},
    {"id": "notes", "description": "Free-text limitations without hidden numeric fields."}
  ],
  "conditional_columns": [
