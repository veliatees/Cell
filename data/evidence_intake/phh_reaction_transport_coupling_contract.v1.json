{
  "schema_version": "cell.phh-reaction-transport-coupling-contract.v1",
  "contract_id": "phh_reaction_transport_coupling_contract_v1",
  "canonical_null_token": "null",
  "transport_scale_definition": "L^2/(D*tau_reaction)",
  "allowed_split_roles": [
    "calibration",
    "internal_validation",
    "independent_heldout"
  ],
  "target_reaction_ids": [
    "glycogen_synthesis",
    "glycogen_breakdown",
    "glucose_export",
    "glutaminase",
    "alanine_transaminase",
    "aspartate_transaminase",
    "glutamate_dehydrogenase",
    "lactate_dehydrogenase",
    "pyruvate_carboxylase",
    "pepck",
    "lower_glycolysis_reverse",
    "fructose_1_6_bisphosphatase",
    "phosphoglucose_isomerase_reverse",
    "glucose_6_phosphatase",
    "hepatic_glucose_output",
    "glycerol_kinase",
    "glycerol_3_phosphate_dehydrogenase",
    "triose_phosphate_condensation",
    "beta_oxidation",
    "thiolase",
    "hmgcs2",
    "hmgcl",
    "bdh1_forward",
    "bdh1_reverse",
    "acetoacetate_decarboxylation",
    "acetyl_coa_carboxylase",
    "fatty_acid_synthase",
    "malonyl_coa_decarboxylase",
    "cpt1_beta_oxidation",
    "cps1",
    "otc",
    "ass1",
    "asl",
    "arg1",
    "atp_regeneration",
    "atp_maintenance"
  ],
  "required_stage_ids": [
    "exact_reaction_identity",
    "participant_compartment_fields",
    "species_mobility_link",
    "characteristic_length_geometry",
    "reaction_timescale_trajectory",
    "transport_perturbation_demonstration",
    "dimensional_coupling_law",
    "independent_heldout_validation"
  ],
  "required_columns": [
    {"id": "record_id", "description": "Globally unique raw reaction-transport observation identifier."},
    {"id": "target_reaction_id", "description": "Exact runtime reaction under evaluation."},
    {"id": "stage_id", "description": "One required transport-coupling evidence stage."},
    {"id": "series_id", "description": "Identifier joining ordered observations from one assay curve."},
    {"id": "observation_index", "description": "Non-negative integer index within the raw series."},
    {"id": "donor_id", "description": "Study-scoped PHH donor identifier."},
    {"id": "split_role", "description": "Calibration, internal validation, or independent held-out assignment."},
    {"id": "source_study_id", "description": "Stable DOI, PMID, repository accession, or primary-study identifier."},
    {"id": "source_locator", "description": "Exact figure, table, raw file, cell, trace, and row locator."},
    {"id": "species", "description": "Must be Homo sapiens."},
    {"id": "biological_system", "description": "Exact primary-human-hepatocyte preparation."},
    {"id": "culture_format", "description": "In-situ, slice, sandwich, spheroid, organoid, or exact culture context."},
    {"id": "tissue_health_state", "description": "Healthy/non-diseased status of the source cells."},
    {"id": "liver_zone", "description": "Measured zonation assignment or explicit unresolved token."},
    {"id": "biological_replicate_id", "description": "Biological replicate identifier; not a synthetic donor."},
    {"id": "reaction_equation", "description": "Exact chemical equation, direction, stoichiometry, isoform, and cofactors."},
    {"id": "reaction_equation_sha256", "description": "SHA-256 fingerprint of the canonical reaction equation text."},
    {"id": "participant_species_ids", "description": "Exact ordered engine species IDs used by the transport claim."},
    {"id": "compartment", "description": "Measured reaction compartment and membrane side."},
    {"id": "localization_method", "description": "Method establishing reaction and participant localization."},
    {"id": "mobility_evidence_record_ids", "description": "Exact PHH intracellular-mobility intake records used."},
    {"id": "geometry_evidence_record_ids", "description": "Exact mesh/morphometry records defining the transport length."},
    {"id": "independent_axis_name", "description": "Time, distance, concentration, perturbation, or other raw axis."},
    {"id": "independent_value", "description": "Finite raw independent-axis value."},
    {"id": "independent_unit", "description": "Original independent-axis unit."},
    {"id": "observed_quantity", "description": "Raw flux, concentration, displacement, reaction output, or transport readout."},
    {"id": "observed_value", "description": "Finite raw observed value."},
    {"id": "observed_unit", "description": "Original observed unit and denominator."},
    {"id": "uncertainty_value", "description": "Finite non-negative raw uncertainty."},
    {"id": "uncertainty_type", "description": "SD, SEM, CI, localization error, fit covariance, or exact definition."},
    {"id": "raw_artifact_path", "description": "Checksum-frozen raw or digitized observation artifact."},
    {"id": "raw_artifact_sha256", "description": "SHA-256 of the exact observation artifact."},
    {"id": "model_or_operator_version", "description": "Frozen measurement/model operator version."},
    {"id": "frozen_before_heldout_access", "description": "Must be true for independent held-out records."},
    {"id": "manual_primary_source_review_status", "description": "Must be pass before scientific promotion."}
  ],
  "conditional_columns": [
    {"id": "apparent_diffusivity_value", "description": "Matched species apparent diffusivity in um2/s."},
    {"id": "apparent_diffusivity_unit", "description": "Must be um2/s when the value is present."},
    {"id": "characteristic_length_value", "description": "Measured/registered transport length in um."},
    {"id": "characteristic_length_unit", "description": "Must be um when the value is present."},
    {"id": "reaction_timescale_value", "description": "Matched reaction timescale in s."},
    {"id": "reaction_timescale_unit", "description": "Must be s when the value is present."},
    {"id": "transport_scale_ratio_value", "description": "Reported dimensionless L^2/(D*tau_reaction)."},
    {"id": "transport_scale_ratio_definition", "description": "Must exactly identify L^2/(D*tau_reaction)."},
    {"id": "coupling_equation", "description": "Complete local advection/diffusion/reaction coupling equation."},
    {"id": "coupling_equation_sha256", "description": "SHA-256 fingerprint of the canonical coupling equation."},
    {"id": "transport_limitation_criterion", "description": "Pre-registered criterion establishing transport limitation."},
    {"id": "transport_limitation_result", "description": "Raw pass/fail/inconclusive result under the criterion."},
    {"id": "perturbation_identity", "description": "Exact geometry, mobility, stirring, binding, or transport perturbation."},
    {"id": "perturbation_value", "description": "Finite perturbation magnitude."},
    {"id": "perturbation_unit", "description": "Original perturbation unit."},
    {"id": "censoring_or_missingness", "description": "Detection limit, truncation, failed assay, or missingness status."}
  ],
  "coupling_gate": {
    "version": "phh_reaction_transport_coupling_gate_v1",
    "minimum_ordered_points_per_dynamic_series": 3,
    "same_donor_required_for_calibration_chain": true,
    "same_reaction_equation_required": true,
    "same_compartment_required": true,
    "matched_species_mobility_records_required": true,
    "measured_characteristic_length_required": true,
    "matched_reaction_timescale_required": true,
    "transport_perturbation_demonstration_required": true,
    "dimensionally_consistent_scale_ratio_required": true,
    "complete_coupling_equation_fingerprint_required": true,
    "healthy_human_context_required": true,
    "donor_disjoint_validation_required": true,
    "independent_heldout_study_required": true,
    "frozen_model_before_heldout_access_required": true,
    "automatic_global_fluid_multiplier": false,
    "automatic_damkohler_threshold": false,
    "automatic_parameter_fitting": false,
    "automatic_local_concentration_coupling": false,
    "automatic_direct_rate_correction": false,
    "automatic_runtime_activation": false
  },
  "policy": {
    "manual_primary_source_review_required": true,
    "mobility_record_without_matching_reaction_context_is_sufficient": false,
    "bulk_tissue_flux_defines_local_reaction_timescale": false,
    "equivalent_sphere_radius_defines_every_transport_length": false,
    "dimensionless_scale_ratio_alone_proves_transport_limitation": false,
    "global_viscosity_multiplier_is_allowed": false,
    "cross_species_transfer_allowed": false,
    "cell_line_transfer_to_healthy_phh_allowed": false,
    "missing_transport_effect_means_no_effect": false,
    "automatic_parameter_activation": false
  }
}
